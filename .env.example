# flohmarkt – Beispielumgebung. Kopieren nach .env (DEV) bzw. in die
# Compose-Datei / Secret-Store (PRODUCTION). KEINE echten Werte ins git!

# --- DJ-Profil: development | production | testing --------------------------
FLOHMARKT_PROFILE=development

# --- Sicherheitswerte --------------------------------------------------------
# Produktion: lange zufällige Zeichenkette (z.B. `python -c "import secrets;print(secrets.token_urlsafe(64))"`)
# Dev-Testläufe: darf leer bleiben (Dev-Fallback greift, Warnung bei --deploy).
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://flohmarkt.example.org,https://api.flohmarkt.example.org

# --- Datenbank (PostgreSQL 18) -----------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flohmarkt
POSTGRES_USER=flohmarkt
POSTGRES_PASSWORD=
# Pooling/Verbindung: optional
DB_CONN_MAX_AGE=60

# --- Dateien ----------------------------------------------------------------
# Dev/Prod: absolueter Pfad, der in ein Volume gemountet wird (z.B. /data/media).
FLOHMARKT_MEDIA_ROOT=./media
FLOHMARKT_SYMBOL_DIR=./images/symbols

# --- Testprofil (nur für `pytest` / CI, optional) ----------------------------
# Falls gesetzt, läuft der Test gegen PostgreSQL statt SQLite:
# DATABASE_URL=
